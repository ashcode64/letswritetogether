# Control plane (Netcup or local :8095)
# Edge containers use this as-is (host.docker.internal works inside Docker).
MENDR_CONTROL_PLANE_URL=http://host.docker.internal:8095

# Optional override for host-side register/deploy scripts when CP is on localhost
# but the edge still points at host.docker.internal. Leave blank to auto-rewrite.
# MENDR_REGISTER_CONTROL_PLANE_URL=http://127.0.0.1:8095

# Edge sync (per-tenant key from CP) — required for Mendr data plane
GATEWAY_EDGE_API_KEY=

# Optional: CP API auth for register (when CP enforces internal key)
GATEWAY_INTERNAL_API_KEY=
MENDR_TENANT_ID=00000000-0000-0000-0000-000000000001

# Auto-register on compose up / deploy (set false to skip)
MENDR_AUTO_REGISTER=true
MENDR_REGISTER_WAIT_SEC=120

# Data plane
MENDR_INGRESS_ENABLED=true
MENDR_HOST_IDENTITY_FALLBACK=true
MENDR_TLS_REQUIRED=false
MENDR_STATIC_BASE_DIR=

# Colorbook → Mendr private host
PROXY_URL=http://mendr-gateway:80
PROXY_HOST=colorbook-internal
PUBLIC_HOST=localhost
PUBLIC_HOST_PROD=sharedpage.app
