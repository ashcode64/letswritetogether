# Private Docker network only. Do not publish this port.
:80 {
	@words path_regexp words ^/v1/rounds/[^/]+/words$
	handle @words {
		reverse_proxy submission:8080
	}
	@vote path_regexp vote ^/v1/rounds/[^/]+/vote$
	handle @vote {
		reverse_proxy voting:8080
	}
	handle /v1/canvas/* {
		reverse_proxy canvas:8080
	}
	handle /v1/events {
		reverse_proxy realtime:8080 {
			flush_interval -1
		}
	}
	@tally path_regexp tally ^/internal/v1/rounds/[^/]+/tally$
	handle @tally {
		reverse_proxy voting:8080
	}
	handle /internal/v1/canvas/append {
		reverse_proxy canvas:8080
	}
	@seal path_regexp seal ^/internal/v1/days/[^/]+/seal$
	handle @seal {
		reverse_proxy archive:8080
	}
	respond "not found" 404
}
