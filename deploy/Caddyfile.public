# Public site. Browser traffic only. Does not route /internal.
# Local compose publishes port 80. Production compose does not: cloudflared
# dials out and forwards to this listener, so the VM has no inbound port.
# Do not cache or buffer /v1/events. Sealed canvas days send their own Cache-Control.
:80 {
	reverse_proxy gateway:8080 {
		flush_interval -1
	}
}
